DATABASE_URL=postgresql://postgres:your_password@localhost:5432/autoledger
PORT=5000
GEMINI_API_KEY=your_gemini_api_key
# Set to 1 only for local development - never in production (enables Werkzeug's
# interactive debugger, which allows remote code execution if exposed to the internet).
FLASK_DEBUG=0

# Auto driver merchant accounts.
# own_keys (default): each driver enters his own Razorpay Key Id / Secret in the app; his QR
#   is created in his account and the money goes straight to him. The RAZORPAY_* keys below
#   are then not used for drivers.
# platform: every driver QR is created in the Razorpay account below.
DRIVER_MERCHANT_MODE=own_keys
# Encrypts drivers' keys in the database. Generate once with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Use the same value on every server sharing the database; if lost, drivers re-enter keys.
DRIVER_KEYS_ENCRYPTION_KEY=

# Razorpay (platform account). Route must be enabled on this account for
# driver merchant accounts; use test-mode keys (rzp_test_...) during development.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Secret set on the Razorpay dashboard webhook pointing at /api/driver/razorpay-webhook
# (events: qr_code.credited, refund.processed, transfer.processed, transfer.failed).
# Without a public URL the app falls back to polling.
RAZORPAY_WEBHOOK_SECRET=
# 0 = no Route: drivers get a QR and automatic records, but the money stays in this
# Razorpay account and you pay drivers out yourself. 1 = linked accounts + auto transfers.
RAZORPAY_ROUTE_ENABLED=0
# Share of each QR payment the platform keeps before transferring to the driver (0-100).
DRIVER_PLATFORM_FEE_PERCENT=0
# Linked-account profile sent to Razorpay when onboarding a driver.
RAZORPAY_LINKED_BUSINESS_TYPE=individual
RAZORPAY_LINKED_CATEGORY=transport
RAZORPAY_LINKED_SUBCATEGORY=cab_hailing
